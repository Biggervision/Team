# Copy to `.env.wordpress` (untracked) and fill in.
# WP_APP_PASSWORD is an Application Password, NOT the login password.
# Create one at: https://staging2.evergreenoc.com/wp-admin/profile.php
#   Users -> Profile -> Application Passwords -> name it "Claude" -> Add
#
# Staging and production are separate WordPress installs; a password created
# on one does not work on the other. Leave WP_SITE on staging unless you
# specifically intend to touch the live site.

WP_SITE=https://staging2.evergreenoc.com
WP_USER=
WP_APP_PASSWORD=
